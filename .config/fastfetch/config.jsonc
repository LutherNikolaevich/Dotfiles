{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "builtin",
        "source": "linux"
    },
    "modules": [
        "title",
        {
            "type": "separator",
            "string": "─"
        },
        "os",
        "kernel",
        "uptime",
        "packages",
        "shell",
        "editor",
        "display",
        "de",
        "wm",
        "wmtheme",
        "theme",
        "icons",
        "font",
        "terminalfont",
        {
            "type": "cpu",
            "showPeCoreCount": true,
            "temp": true
        },
        {
            "type": "gpu",
            "driverSpecific": true,
            "temp": true
        },
        "memory",
        "physicalmemory",
        {
            "type": "swap",
            "separate": true
        },
        "disk",
        {
            "type": "physicaldisk",
            "temp": true
        },
        "break",
        {
            "type": "colors",
            "symbol": "circle"
        }

    ]
}